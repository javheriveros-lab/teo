# ================================================================
# TEO - Asistente de WhatsApp de I'AM
# Variables de Entorno (.env)
# ================================================================

# API Key de OpenRouter (https://openrouter.ai/keys) — motor de IA principal de TEO
OPENROUTER_API_KEY=tu_api_key_de_openrouter_aqui

# API Key de Groq (https://console.groq.com/keys) — sin uso activo, se deja por si se vuelve a usar
GROQ_API_KEY=tu_api_key_de_groq_aqui

# API Key de Gemini (Google AI Studio) — visión (video de ejercicio, comprobantes de pago)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Token de Acceso de WhatsApp Cloud API (Graph API)
# Se obtiene en Meta for Developers > Tu App > WhatsApp > Configuración de la API
WHATSAPP_TOKEN=tu_token_de_acceso_de_whatsapp_aqui

# ID del número de teléfono comercial de WhatsApp
# Se obtiene en Meta for Developers > Tu App > WhatsApp > Configuración de la API
PHONE_NUMBER_ID=tu_phone_number_id_aqui

# ID de la Cuenta de WhatsApp Business (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=tu_waba_id_aqui

# Token de verificación para el Webhook de Meta
# Cadena secreta y personalizada que configuras tanto aquí como en el panel de Meta Webhooks
WEBHOOK_VERIFY_TOKEN=tu_token_de_verificacion_personalizado_aqui

# Versión de la API de Meta Graph
META_GRAPH_API_VERSION=v21.0

# Configuración del Servidor
PORT=8000
HOST=0.0.0.0
DEBUG=True
